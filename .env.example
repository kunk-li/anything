# 复制为 .env 后填入真实值. .env 已在 .gitignore, 不会被提交.
#
# 启动 bootstrap 会自动加载本文件 (现有 env > .env)
# 详见 docs/secrets-management.md

# ============ LLM Providers ============

# OpenAI / OpenAI 兼容(用于 text-embedding 和 gpt 系列)
OPENAI_API_KEY=

# 阿里 DashScope (qwen 系列, OpenAI 兼容协议)
DASHSCOPE_API_KEY=

# ============ Vector DB ============

# 本项目默认 FAISS 本地存储,不需要 api_key
# 若切换到云端向量库 (Pinecone/Weaviate/Qdrant Cloud) 在此填写
VECTOR_DB_API_KEY=

# ============ Security ============

# JWT secret (生产部署用; dev 可填测试值)
# 推荐 openssl rand -hex 32 生成
JWT_SECRET=dev_jwt_secret_change_in_prod

# API Key 鉴权(security.auth_type=apikey 时生效)
API_KEY_1=dev_api_key_1_change_in_prod

# 加密配置的对称密钥 (config_module 的 encrypt_sensitive_config 用)
# 推荐 openssl rand -base64 32 生成
SENSITIVE_CONFIG_SECRET=dev_sensitive_secret_change_in_prod

# ============ Dev Mode Switches ============

# 开发模式:允许 LLM/向量库等关键依赖初始化失败时回退,
# 而不是 fail-fast。生产环境必须 unset 或 =0.
ANYTHING_DEV_MODE=1

# ============ Runtime Tuning (可选, 详见 docs/configuration-priority.md) ============

# RAG 检索参数
# ANYTHING_RAG_TOP_K_RETRIEVE=50
# ANYTHING_RAG_TOP_K_RERANK=8
# ANYTHING_RAG_ENABLE_RERANK=false
# ANYTHING_RAG_ENABLE_REWRITE=false

# Agent 行为
# ANYTHING_AGENT_TIMEOUT=60
# ANYTHING_AGENT_EXECUTION_STRATEGY=single_shot   # 或 react
# ANYTHING_AGENT_MAX_REACT_ITER=5
